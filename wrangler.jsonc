// Cloudflare Workers config: static site (dist/) + reviews API + D1 database.
// One-time setup (see DEPLOYMENT.md):
//   npx wrangler login
//   npx wrangler d1 create mm-reviews            -> paste the database_id it prints below
//   npx wrangler d1 migrations apply mm-reviews --remote
//   npx wrangler secret put ADMIN_PASSWORD
//   npx wrangler secret put SESSION_SECRET
// Deploy: npm run deploy
{
  "name": "mm-enterprises",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mm-reviews",
      "database_id": "2abbe3b1-41b8-4b20-8a8e-40af20644ccf",   // created with `npx wrangler d1 create mm-reviews` (APAC)
      "migrations_dir": "migrations"
    }
  ],
  // Zone routes: the Worker answers every request on these hostnames. They need proxied (orange-cloud) DNS records
  // for mm-enterprises-service.com and www in the Cloudflare zone; the record targets are never contacted.
  "routes": [
    { "pattern": "mm-enterprises-service.com/*", "zone_name": "mm-enterprises-service.com" },
    { "pattern": "www.mm-enterprises-service.com/*", "zone_name": "mm-enterprises-service.com" }
  ]
}
